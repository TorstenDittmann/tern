amends "https://orch.torsten.work/pkl/v1alpha1/Application.pkl"

// tern.torsten.work, served by orch as a static site. Build first with
// `bun run build`; the deploy workflow is .github/workflows/website-deploy.yml.

name = "tern"

services {
  ["web"] {
    // Unknown paths get dist/404.html with status 404.
    static = new Static { dir = "dist" }
    http { domains { "tern.torsten.work" } }
  }
}
